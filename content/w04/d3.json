 "evening": {
  "listening": {
   "title": "Changing a meeting",
   "script": [
    {
     "speaker": "Mr. Brown",
     "text": "Lincoln Elementary, front office. Mr. Brown speaking."
    },
    {
     "speaker": "Hafsa",
     "text": "Hello, Mr. Brown. This is Hafsa. I'm meeting the principal on Friday at ten, but I have a problem."
    },
    {
     "speaker": "Mr. Brown",
     "text": "What is the problem?"
    },
    {
     "speaker": "Hafsa",
     "text": "Emre is having a test that morning, and I'm driving him to school. Can we change the time?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Let me check the calendar. The principal is busy on Friday afternoon. Is Thursday good for you?"
    },
    {
     "speaker": "Hafsa",
     "text": "Thursday is fine. I'm free all day."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Okay. Is two o'clock available?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, two o'clock is perfect."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Great. I'll put it in the calendar. I'll send you an email to confirm."
    },
    {
     "speaker": "Hafsa",
     "text": "Thank you. I'll check my email tonight."
    },
    {
     "speaker": "Mr. Brown",
     "text": "See you on Thursday at two."
    },
    {
     "speaker": "Hafsa",
     "text": "See you then. Thank you for your help!"
    }
   ],
