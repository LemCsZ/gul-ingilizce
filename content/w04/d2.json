 "morning": {
  "grammar": {
   "topic": "will (decisions, promises, offers)",
   "explainTr": [
    "'Will' ile o anda verdiğin kararı (I'll have the soup), sözünü (I will call you) ve yardım teklifini (I'll carry it) söylersin. Kısaltması 'll: I'll, she'll, we'll.",
    "'Will' her özneyle aynı kalır ve ardından yalın fiil gelir: She will pay. Olumsuzu 'will not' ya da 'won't'. Soru: Will you help me?",
    "Kısa kural: Daha önce planladığın şey için 'going to', o anda karar verdiğin ya da söz verdiğin şey için 'will' kullan."
   ],
   "compareTr": "Türkçede 'yapacağım' hem planı hem sözü anlatır. İngilizcede ayrım var: 'I'll have the soup' (o an karar), 'I'm going to visit Linda' (önceki plan). 'Will' sonrasında 'to' ve -s almaz: I will to go yanlış.",
   "table": [
    [
     "I / you / he / she / we / they",
     "will + fiil",
     "She will pay."
    ],
    [
     "Kısaltma",
     "'ll",
     "I'll help you."
    ],
    [
     "Olumsuz",
     "will not / won't",
     "I won't forget."
    ],
    [
     "Soru",
     "Will + özne + fiil?",
     "Will you help me?"
    ],
    [
     "Kısa cevap",
     "Yes, I will. / No, I won't.",
     "Will he come? Yes, he will."
    ]
   ],
   "examples": [
    {
     "en": "I'll have the soup, please.",
     "tr": "Çorba alacağım lütfen."
    },
    {
     "en": "I will call you tomorrow.",
     "tr": "Seni yarın arayacağım."
    },
    {
     "en": "Don't worry. I'll help you.",
     "tr": "Merak etme. Sana yardım edeceğim."
    },
    {
     "en": "She won't be late.",
     "tr": "O geç kalmayacak."
    },
    {
     "en": "Will you bring the menu?",
     "tr": "Menüyü getirir misin?"
    }
   ],
