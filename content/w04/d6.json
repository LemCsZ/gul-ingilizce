 "evening": {
  "listening": {
   "title": "The winter concert",
   "script": [
    {
     "speaker": "Hafsa",
     "text": "Hello, Mr. Brown. Can you tell me about the winter concert?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Sure. It's on December 12 at 6:30 in the evening."
    },
    {
     "speaker": "Hafsa",
     "text": "Is it in the gym?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "No, it's in the cafeteria this year. The gym is closed for repairs."
    },
    {
     "speaker": "Hafsa",
     "text": "And what time does school end on that day?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "At 3:15, as usual. The students are going to practice at 4:00."
    },
    {
     "speaker": "Hafsa",
     "text": "Good. Is there a school holiday in December?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Yes. Winter break starts on December 20 and ends on January 5."
    },
    {
     "speaker": "Hafsa",
     "text": "Thank you. Do you need volunteers for the concert?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Yes, please! Can you come at 5:30 on the day of the concert?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I can. I'll be in the cafeteria at 5:30."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Perfect. See you then."
    }
   ],
