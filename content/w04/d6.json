     "on Friday / on October 12 / on the wall"
    ],
    [
     "in",
     "ay, yıl, mevsim, günün bölümü, alan, şehir",
     "in July / in the morning / in the gym"
    ],
    [
     "Sabit kalıplar",
     "at night, at noon, on the weekend",
     "Don't call me at night."
    ]
   ],
