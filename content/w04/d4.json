 "morning": {
  "grammar": {
   "topic": "articles: a / an / the / no article",
   "explainTr": [
    "'A' ve 'an' ilk kez söz ettiğin tek bir şeyin önüne gelir: I have a cat. Sesli sesle başlıyorsa 'an': an apple, an hour. Kelimenin yazılışına değil, okunuşuna bak.",
    "'The' hem konuşanın hem dinleyenin bildiği şeyin önüne gelir: The cat is small (az önce söylediğim kedi). Dünyada tek olan şeylerde de 'the' kullanılır: the sun, the moon.",
    "Artikel hiç kullanılmayan yerler: genel çoğul ve sayılamayan isimler (I like music), diller (Turkish), öğünler (breakfast), şehir ve ülke adları ve go to school / go to work / go home kalıpları."
   ],
   "compareTr": "Türkçede artikel yoktur; 'bir' kelimesi her zaman gerekmez. İngilizcede tekil sayılabilir isimden önce mutlaka a/an ya da the gerekir: 'I have car' yanlış, 'I have a car' doğru.",
   "table": [
    [
     "a + sessiz ses",
     "a city, a bridge",
     "She has a car."
    ],
    [
     "an + sesli ses",
     "an apple, an hour",
     "I need an umbrella."
    ],
    [
     "the",
     "belli / tek şey",
     "The sun is hot."
    ],
    [
     "artikel yok",
     "genel çoğul, dil, öğün",
     "I like music."
    ],
    [
     "artikel yok",
     "kalıplar",
     "go to school / work"
    ]
   ],
