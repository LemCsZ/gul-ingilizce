 "evening": {
  "listening": {
   "title": "Linda and Hafsa remember the first day",
   "script": [
    {
     "speaker": "Linda",
     "text": "Hafsa, how was your trip to America?"
    },
    {
     "speaker": "Hafsa",
     "text": "It was long. We had a flight of eleven hours."
    },
    {
     "speaker": "Linda",
     "text": "Eleven hours! Were you tired?"
    },
    {
     "speaker": "Hafsa",
     "text": "Very tired. I slept for only two hours."
    },
    {
     "speaker": "Linda",
     "text": "Was everything strange?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes. The language, the food, the streets. I felt homesick."
    },
    {
     "speaker": "Linda",
     "text": "I remember your first day. You came to my door with Emre and said hello."
    },
    {
     "speaker": "Hafsa",
     "text": "And you gave us a plate of cookies!"
    },
    {
     "speaker": "Linda",
     "text": "Yes, and you made tea for me."
    },
    {
     "speaker": "Hafsa",
     "text": "Tea is very important in Turkey."
    },
    {
     "speaker": "Linda",
     "text": "Now you know the whole neighborhood."
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, and I found a language class. I met two new friends there."
    }
