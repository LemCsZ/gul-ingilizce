 "titleTr": "Çocukluğun: was ve were",
 "theme": "childhood",
 "morning": {
  "grammar": {
   "topic": "was / were (to be, past)",
   "explainTr": [
    "'Was' ve 'were', 'am/is/are'ın geçmiş halidir. I, he, she, it ile 'was'; you, we, they ile 'were' kullanılır: I was happy. They were at home.",
    "Olumsuzu 'wasn't' ve 'weren't'tir. Soruda fiil başa geçer: Was she tired? Were you at school? Kısa cevap: Yes, she was. / No, they weren't.",
    "'There was' tekil, 'there were' çoğul şeyler için kullanılır: There was a garden. There were many roses. Geçmiş zaman işaretleri: yesterday, last year, in 1998, when I was a child."
   ],
   "compareTr": "Türkçede geçmiş zaman fiile eklenir: 'yorgundum', 'evdeydik'. İngilizcede 'was/were' ayrı bir kelimedir: I was tired, we were at home. Özneyi unutma: 'Was tired' değil, 'I was tired'.",
   "table": [
    [
     "I / he / she / it",
     "was",
     "I was a shy child."
    ],
    [
     "you / we / they",
     "were",
     "We were happy."
    ],
    [
     "Olumsuz",
     "wasn't / weren't",
     "He wasn't at home."
    ],
    [
     "Soru",
     "Was / Were + özne?",
     "Were you tired?"
    ],
    [
     "Kısa cevap",
     "Yes, I was. / No, we weren't.",
     "Was it big? No, it wasn't."
    ],
    [
     "there",
     "there was / there were",
     "There were many roses."
    ]
   ],
   "examples": [
    {
     "en": "I was a shy child.",
     "tr": "Utangaç bir çocuktum."
    },
    {
     "en": "The village was very quiet.",
     "tr": "Köy çok sessizdi."
    },
    {
     "en": "We weren't rich, but we were happy.",
     "tr": "Zengin değildik ama mutluyduk."
    },
    {
     "en": "Were you tired yesterday?",
     "tr": "Dün yorgun muydun?"
    },
    {
     "en": "There were many roses in the garden.",
     "tr": "Bahçede çok gül vardı."
    }
   ],
