 "week": 5,
 "day": 1,
 "titleTr": "Hayat deneyimleri: Have you ever...?",
 "theme": "experience",
 "morning": {
  "grammar": {
   "topic": "Present Perfect: ever / never",
   "explainTr": [
    "Hayatında bir zamanda yaptığın (ya da hiç yapmadığın) şeyleri 'have/has + fiilin 3. hali' ile anlatırsın: I have visited Texas. (Texas'a gittim, ne zaman olduğu önemli değil.)",
    "Deneyim sormak için 'Have you ever...?' denir: Have you ever worked in a school? Cevap: Yes, I have. / No, I haven't. Hiç yapmadıysan 'never' kullan: I have never taught a class.",
    "'Gitmek' için 'have been to' kullanılır: I have been to Boston. Mülakatlarda en çok bu soruyu duyarsın."
   ],
   "compareTr": "Türkçede 'Hiç ... yaptın mı?' tek ek (-dı mı?) ile kurulur. İngilizcede 'Have you ever + 3. hal?' diye kalıp kullanılır; 'ever' hiç demektir.",
   "table": [
    [
     "I / you / we / they",
     "have + V3",
     "I have worked."
    ],
    [
     "he / she / it",
     "has + V3",
     "She has worked."
    ],
    [
     "Olumsuz",
     "have not / never + V3",
     "I have never flown."
    ],
    [
     "Soru",
     "Have + özne + ever + V3?",
     "Have you ever flown?"
    ],
    [
     "Kısa cevap",
     "Yes, I have. / No, I haven't.",
     "Have you? No, I haven't."
    ],
    [
     "be (3. hal)",
     "been (to)",
     "I have been to Texas."
    ]
   ],
   "examples": [
    {
     "en": "I have worked in a school library.",
     "tr": "Okul kütüphanesinde çalıştım."
    },
    {
     "en": "She has never taught a class.",
     "tr": "O hiç ders vermedi."
    },
    {
     "en": "Have you ever been to Boston?",
     "tr": "Hiç Boston'a gittin mi?"
    },
    {
     "en": "Yes, I have. / No, I haven't.",
     "tr": "Evet, gittim. / Hayır, gitmedim."
    },
    {
     "en": "They have never eaten sushi.",
     "tr": "Onlar hiç suşi yemedi."
    }
   ],
