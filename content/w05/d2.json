 "evening": {
  "listening": {
   "title": "Checking the list",
   "script": [
    {
     "speaker": "Mr. Brown",
     "text": "Hafsa, let's check the list before lunch."
    },
    {
     "speaker": "Hafsa",
     "text": "Okay. Which task is first?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Have you sent the letters to the parents yet?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I have. I sent them an hour ago."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Great. Have you copied the field trip forms?"
    },
    {
     "speaker": "Hafsa",
     "text": "Not yet. The copy machine isn't working."
    },
    {
     "speaker": "Mr. Brown",
     "text": "I have just called the repair person. He is coming at one."
    },
    {
     "speaker": "Hafsa",
     "text": "Good. I have already printed the new class lists, though."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Perfect. Is the deadline for the report on Friday?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, and I have almost finished it. I just need the final numbers."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Have you called Ms. Carter about the meeting?"
    },
    {
     "speaker": "Hafsa",
     "text": "Not yet. I am going to call her now."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Thank you. You are doing a great job."
    }
   ],
