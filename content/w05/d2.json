 "morning": {
  "grammar": {
   "topic": "Present Perfect: just / already / yet",
   "explainTr": [
    "Present Perfect ile 'just' (az önce), 'already' (çoktan) ve 'yet' (henüz) kullanılır. Hepsi yakın zamanda biten ya da bitmeyen işleri anlatır: I have just finished. (Az önce bitirdim.)",
    "'Just' ve 'already' have/has ile fiilin arasına girer: I have already sent it. 'Yet' olumsuz cümlelerin ve soruların sonuna gelir: I haven't finished yet. Have you finished yet?",
    "Olumlu cümlede 'yet' kullanma; 'already' kullan. Kısa cevaplar: Yes, I have. / No, not yet."
   ],
   "compareTr": "Türkçede 'bitirdim' cümlesi aynı kalır, 'az önce', 'çoktan', 'henüz' kelimeleri eklenir. İngilizcede bu kelimelerin cümledeki yeri sabittir: just ve already ortada, yet sonda.",
   "table": [
    [
     "just",
     "have/has + just + V3",
     "I have just called him."
    ],
    [
     "already",
     "have/has + already + V3",
     "She has already left."
    ],
    [
     "yet (olumsuz)",
     "haven't + V3 + yet",
     "I haven't finished yet."
    ],
    [
     "yet (soru)",
     "Have you + V3 + yet?",
     "Have you sent it yet?"
    ],
    [
     "Kısa cevap",
     "Yes, I have. / No, not yet.",
     "Have you printed it? No, not yet."
    ]
   ],
   "examples": [
    {
     "en": "I have just finished the report.",
     "tr": "Raporu az önce bitirdim."
    },
    {
     "en": "She has already sent the email.",
     "tr": "O e-postayı çoktan gönderdi."
    },
    {
     "en": "I haven't called the parents yet.",
     "tr": "Velileri henüz aramadım."
    },
    {
     "en": "Have you printed the forms yet?",
     "tr": "Formları henüz yazdırdın mı?"
    },
    {
     "en": "No, not yet.",
     "tr": "Hayır, henüz değil."
    }
   ],
