  "listening": {
   "title": "Which job is better?",
   "script": [
    {
     "speaker": "Emre",
     "text": "Mom, which job is better, the school office or the library?"
    },
    {
     "speaker": "Hafsa",
     "text": "The library is quieter, but the school office is busier and more interesting."
    },
    {
     "speaker": "Emre",
     "text": "Is the salary higher at the school?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, it is. It is five dollars more an hour."
    },
    {
     "speaker": "Emre",
     "text": "What about the hours?"
    },
    {
     "speaker": "Hafsa",
     "text": "The library is shorter. It closes at three. The school closes at four."
    },
    {
     "speaker": "Emre",
     "text": "And which one is more convenient?"
    },
    {
     "speaker": "Hafsa",
     "text": "The library is closer to our apartment. But the bus to the school is cheaper than a car."
    },
    {
     "speaker": "Emre",
     "text": "So the school is the better choice?"
    },
    {
     "speaker": "Hafsa",
     "text": "I think so. The people are friendlier, and I can learn more."
    },
    {
     "speaker": "Emre",
     "text": "Then take the school job. It is the best way to become a teacher."
    },
    {
     "speaker": "Hafsa",
     "text": "You are right, Emre. Thank you."
    }
