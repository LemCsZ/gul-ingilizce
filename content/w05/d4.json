  "grammar": {
   "topic": "can / could / should (tavsiye)",
   "explainTr": [
    "Tavsiye vermek için 'should' kullanılır: You should rest. (Dinlenmelisin.) Olumsuzu 'shouldn't': You shouldn't drink so much coffee. 'Should'dan sonra 'to' gelmez, fiil yalın kalır.",
    "'Could' bir seçenek önerir: You could take a walk. (İstersen yürüyüşe çıkabilirsin.) 'Could you...?' kibar rica içindir; geçmişte yapabildiğin şeyleri de anlatır: I could swim when I was young.",
    "'Can' şimdiki yetenek ve izin içindir. Tavsiye sormak için 'Should I...?' denir: Should I see a doctor?"
   ],
   "compareTr": "Türkçede tavsiye fiilin sonuna eklenir (dinlenmelisin). İngilizcede 'should' ayrı bir kelimedir ve her özneyle aynı kalır: I / she / they should rest.",
   "table": [
    [
     "Tavsiye",
     "should + fiil",
     "You should sleep more."
    ],
    [
     "Olumsuz",
     "shouldn't + fiil",
     "You shouldn't work late."
    ],
    [
     "Soru",
     "Should + özne + fiil?",
     "Should I see a doctor?"
    ],
    [
     "Öneri",
     "could + fiil",
     "You could walk to work."
    ],
    [
     "Kibar rica",
     "Could you + fiil?",
     "Could you help me?"
    ],
    [
     "Geçmiş yetenek",
     "could + fiil",
     "I could run fast."
    ]
   ],
   "examples": [
