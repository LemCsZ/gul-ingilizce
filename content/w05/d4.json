   "title": "Advice from the doctor",
   "script": [
    {
     "speaker": "Doctor",
     "text": "Hello, Hafsa. What is the problem today?"
    },
    {
     "speaker": "Hafsa",
     "text": "I am always tired, and I have a lot of stress."
    },
    {
     "speaker": "Doctor",
     "text": "How many hours do you sleep?"
    },
    {
     "speaker": "Hafsa",
     "text": "About five hours a night."
    },
    {
     "speaker": "Doctor",
     "text": "That is not enough. You should sleep seven or eight hours."
    },
    {
     "speaker": "Hafsa",
     "text": "But I work and study. I don't have much time."
    },
    {
     "speaker": "Doctor",
     "text": "You shouldn't study late at night. You could study in the morning instead."
    },
    {
     "speaker": "Hafsa",
     "text": "Okay. What about food?"
    },
    {
     "speaker": "Doctor",
     "text": "You should eat more vegetables and drink more water. You shouldn't drink so much coffee."
    },
    {
     "speaker": "Hafsa",
     "text": "Can I take a vitamin?"
    },
    {
     "speaker": "Doctor",
     "text": "You could, but a good diet is better. Also, you should walk for thirty minutes every day."
    },
    {
     "speaker": "Hafsa",
     "text": "That sounds easy. Thank you, Doctor."
    },
    {
     "speaker": "Doctor",
     "text": "Come back in a month, and we can talk again."
    }
