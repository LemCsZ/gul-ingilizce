 "evening": {
  "listening": {
   "title": "Free time and work",
   "script": [
    {
     "speaker": "Linda",
     "text": "Hafsa, what do you like doing on weekends?"
    },
    {
     "speaker": "Hafsa",
     "text": "I like cooking and walking in the park. What about you?"
    },
    {
     "speaker": "Linda",
     "text": "I love painting, but I hate cleaning the house."
    },
    {
     "speaker": "Hafsa",
     "text": "I know! I don't like cleaning, either."
    },
    {
     "speaker": "Linda",
     "text": "Do you like your new job at the school?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I do. I like working with people, so I enjoy the front office."
    },
    {
     "speaker": "Linda",
     "text": "Would you like to work in a classroom some day?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I would. I want to be a substitute teacher."
    },
    {
     "speaker": "Linda",
     "text": "That is a great plan. Are you nervous?"
    },
    {
     "speaker": "Hafsa",
     "text": "A little, because my English is not perfect."
    },
    {
     "speaker": "Linda",
     "text": "But you are patient, so you will be a good teacher."
    },
    {
     "speaker": "Hafsa",
     "text": "Thank you, Linda. Would you like to come for tea on Sunday?"
    },
    {
     "speaker": "Linda",
     "text": "I would love to! I can bring a cake."
    }
   ],
