 "evening": {
  "listening": {
   "title": "Calling the school office",
   "script": [
    {
     "speaker": "Mr. Brown",
     "text": "Lincoln Elementary, school office. This is Mr. Brown."
    },
    {
     "speaker": "Hafsa",
     "text": "Hello, Mr. Brown. This is Hafsa. I want to talk about substitute work."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Of course. When can you come to the school?"
    },
    {
     "speaker": "Hafsa",
     "text": "What days are good for you?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "I'm free on Tuesday and Thursday."
    },
    {
     "speaker": "Hafsa",
     "text": "Tuesday is good. What time?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "How about two thirty in the afternoon?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, two thirty is fine. Where is your office?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "It's in the main building, room twelve. It's next to the library."
    },
    {
     "speaker": "Hafsa",
     "text": "Thank you. So that's Tuesday, November tenth, at two thirty?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "That's right. Please bring your ID."
    },
    {
     "speaker": "Hafsa",
     "text": "I will. Thank you very much. See you on Tuesday."
    }
