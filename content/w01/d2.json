    "reading": {
      "title": "Meet Hafsa and her neighbor",
      "text": "Hello! My name is Hafsa. I am from Isparta, a small city in Turkey. Now I live in Ohio with my family. My husband is Murat. He is a nurse at a big hospital. My son is Emre. He is fifteen years old. He is a student at Lincoln High School.\n\nMy neighbor is Linda. She is very nice. She is a teacher. Linda is not from Turkey. She is from Texas. Her husband is not at home today. Linda and I are friends now. We drink tea on Saturday.\n\nI am happy in my new country. English is hard, but I study every day.",
      "glossary": [
        {"en": "hospital", "tr": "hastane"},
        {"en": "student", "tr": "öğrenci"},
        {"en": "hard", "tr": "zor"},
        {"en": "study", "tr": "çalışmak, ders çalışmak"}
      ],
      "questions": [
        {"type": "mcq", "q": "Where is Hafsa from?", "options": ["Isparta", "Texas", "Ohio"], "answer": 0, "whyTr": "Metinde 'I am from Isparta' yazıyor.", "tag": "reading", "level": "A1"},
        {"type": "mcq", "q": "What is Murat's job?", "options": ["He is a teacher.", "He is a nurse.", "He is a student."], "answer": 1, "whyTr": "'He is a nurse at a big hospital.'", "tag": "reading", "level": "A1"},
        {"type": "mcq", "q": "Who is Linda?", "options": ["Hafsa's sister", "Hafsa's neighbor", "Hafsa's mother"], "answer": 1, "whyTr": "'My neighbor is Linda.'", "tag": "reading", "level": "A1"},
        {"type": "mcq", "q": "Which sentence is true?", "options": ["Linda is from Turkey.", "Emre is a student.", "Murat is a teacher."], "answer": 1, "whyTr": "Emre Lincoln High School'da öğrenci.", "tag": "reading", "level": "A1"}
      ]
    }
