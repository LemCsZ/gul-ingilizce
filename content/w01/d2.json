{
  "week": 1,
  "day": 2,
  "titleTr": "Kendini ve aileni tanıt",
  "theme": "family",
  "morning": {
    "grammar": {
      "topic": "to be: am / is / are",
      "explainTr": [
        "'to be' İngilizcenin en önemli fiilidir: kim olduğunu, nereli olduğunu ve ne iş yaptığını söylemek için kullanırız. I ile 'am', he / she / it ile 'is', you / we / they ile 'are' gelir.",
        "Olumsuz yapmak için fiilin arkasına 'not' koy: I am not, she is not (isn't), they are not (aren't). Soru yapmak için fiili başa al: Are you a teacher? Is she your sister?"
      ],
      "compareTr": "Türkçede 'öğretmenim' tek kelimedir; ek her şeyi söyler. İngilizcede özneyi ve fiili ayrı yazarız: 'I am a teacher'. Bu yüzden 'I am' ya da 'she is' kısmını atlama.",
      "table": [
        ["I", "am", "I'm / I am not"],
        ["he / she / it", "is", "she's / she isn't"],
        ["you / we / they", "are", "we're / they aren't"],
        ["Soru", "Am I / Is he / Are you ...?", "Are you from Turkey?"]
      ],
      "examples": [
        {"en": "I am from Turkey.", "tr": "Türkiyeliyim."},
        {"en": "She is my sister.", "tr": "O benim kız kardeşim."},
        {"en": "They are not at home.", "tr": "Onlar evde değil."},
        {"en": "Are you a teacher?", "tr": "Öğretmen misin?"}
      ],
      "exercises": [
        {"type": "mcq", "q": "I ___ from Turkey.", "options": ["am", "is", "are"], "answer": 0, "whyTr": "I ile her zaman 'am' kullanılır.", "tag": "to-be", "level": "A1"},
        {"type": "mcq", "q": "My sister ___ a nurse.", "options": ["am", "is", "are"], "answer": 1, "whyTr": "My sister tekil, yani 'she' demek; 'is' gelir.", "tag": "to-be", "level": "A1"},
        {"type": "mcq", "q": "They ___ my neighbors.", "options": ["is", "am", "are"], "answer": 2, "whyTr": "They ile 'are' kullanılır.", "tag": "to-be", "level": "A1"},
        {"type": "mcq", "q": "He ___ a doctor. He is a teacher.", "options": ["isn't", "don't", "aren't"], "answer": 0, "whyTr": "He ile olumsuz hali 'isn't' (is not) olur.", "tag": "negative-form", "level": "A1"},
        {"type": "mcq", "q": "___ you from Mexico?", "options": ["Is", "Are", "Do"], "answer": 1, "whyTr": "You ile soru 'Are you ...?' diye başlar.", "tag": "question-form", "level": "A1"},
        {"type": "mcq", "q": "Linda and I ___ friends.", "options": ["is", "am", "are"], "answer": 2, "whyTr": "Linda and I = we, bu yüzden 'are'.", "tag": "to-be", "level": "A1"},
        {"type": "order", "promptTr": "Cümleyi sırala:", "words": ["is", "This", "my", "mother"], "answer": "This is my mother", "whyTr": "Sıra: özne + fiil + gerisi.", "tag": "word-order", "level": "A1"},
        {"type": "order", "promptTr": "Cümleyi sırala:", "words": ["not", "I", "am", "married"], "answer": "I am not married", "whyTr": "'not' fiilden hemen sonra gelir.", "tag": "negative-form", "level": "A1"},
        {"type": "order", "promptTr": "Soruyu sırala:", "words": ["Is", "your", "husband", "a", "teacher"], "answer": "Is your husband a teacher", "whyTr": "Soruda 'is' cümlenin başına geçer.", "tag": "question-form", "level": "A1"},
        {"type": "order", "promptTr": "Soruyu sırala:", "words": ["are", "Where", "you", "from"], "answer": "Where are you from", "whyTr": "Soru kelimesi (where) başta, sonra 'are'.", "tag": "question-form", "level": "A1"},
        {"type": "fill", "q": "My children ___ at school now.", "accept": ["are"], "hintTr": "children = they", "whyTr": "Children çoğul (they); 'are' gelir.", "tag": "to-be", "level": "A1"},
        {"type": "fill", "q": "I ___ not a teacher.", "accept": ["am"], "hintTr": "I için to be", "whyTr": "I ile 'am' kullanılır.", "tag": "negative-form", "level": "A1"}
      ]
    },
