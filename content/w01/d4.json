 "evening": {
  "listening": {
   "title": "At the clinic desk",
   "script": [
    {
     "speaker": "Receptionist",
     "text": "Good morning. Valley Health Clinic. How can I help you?"
    },
    {
     "speaker": "Hafsa",
     "text": "Hello. I have an appointment with Dr. Lee at 10:30."
    },
    {
     "speaker": "Receptionist",
     "text": "What is your name, please?"
    },
    {
     "speaker": "Hafsa",
     "text": "My name is Hafsa. H-A-F-S-A."
    },
    {
     "speaker": "Receptionist",
     "text": "Yes, I see it. Do you have your insurance card?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I do. Here it is."
    },
    {
     "speaker": "Receptionist",
     "text": "Thank you. What is the problem today?"
    },
    {
     "speaker": "Hafsa",
     "text": "I have a bad headache, and my stomach hurts."
    },
    {
     "speaker": "Receptionist",
     "text": "Do you have a fever?"
    },
    {
     "speaker": "Hafsa",
     "text": "No, I don't. But I have a cough."
    },
    {
     "speaker": "Receptionist",
     "text": "OK. Please sit down. The nurse is ready in ten minutes."
    },
    {
     "speaker": "Hafsa",
     "text": "Thank you very much."
    }
   ],
