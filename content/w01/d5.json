 "evening": {
  "listening": {
   "title": "At the school office",
   "script": [
    {
     "speaker": "Mr. Brown",
     "text": "Good morning, Hafsa. Please come in and sit down."
    },
    {
     "speaker": "Hafsa",
     "text": "Thank you, Mr. Brown. Can I ask a question?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Of course. What is it?"
    },
    {
     "speaker": "Hafsa",
     "text": "Can I work as a substitute teacher here?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Yes, you can, but first you need to fill out a form. Can you use a computer?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I can. I can type, and I can use email."
    },
    {
     "speaker": "Mr. Brown",
     "text": "Great. Can you speak Spanish? Many of our parents speak it."
    },
    {
     "speaker": "Hafsa",
     "text": "No, I can't. I speak Turkish, and I'm learning English."
    },
    {
     "speaker": "Mr. Brown",
     "text": "That's fine. Please fill out this form, and don't forget your ID."
    },
    {
     "speaker": "Hafsa",
     "text": "Can you give me a pen, please?"
    },
    {
     "speaker": "Mr. Brown",
     "text": "Sure. Here you are. Bring the form back on Friday."
    }
   ],
