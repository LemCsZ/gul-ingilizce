 "morning": {
  "grammar": {
   "topic": "Present Continuous: şu anda olanlar (am/is/are + -ing)",
   "explainTr": [
    "Present Continuous, şu anda olan ya da bu dönemde devam eden bir işi anlatır. Yapı: am / is / are + fiil-ing. I am waiting. She is calling. They are standing.",
    "Yazım: make → making (e düşer), run/sit/put → running/sitting/putting (ünsüz ikilenir). Olumsuz: isn't / aren't / am not + fiil-ing. Soru: Is she calling? Are you waiting?",
    "Sık kullanılan işaretler: now, right now, at the moment, today, Look!, Listen!"
   ],
   "compareTr": "Türkçede 'bekliyorum' hem şu an hem alışkanlık için kullanılır. İngilizcede ayrım var: şu an için I am waiting, alışkanlık için I wait. Ayrıca 'am/is/are' unutulmamalı: 'I waiting' yanlış.",
   "table": [
    [
     "I",
     "am + fiil-ing",
     "I am waiting."
    ],
    [
     "he / she / it",
     "is + fiil-ing",
     "She is calling."
    ],
    [
     "you / we / they",
     "are + fiil-ing",
     "They are standing."
    ],
    [
     "Olumsuz",
     "isn't / aren't / am not",
     "He isn't buying."
    ],
    [
     "Soru",
     "Is / Are + özne + -ing?",
     "Are you waiting?"
    ]
   ],
   "examples": [
    {
     "en": "I am buying rice.",
     "tr": "Pirinç alıyorum."
    },
    {
     "en": "Emre is watching a movie.",
     "tr": "Emre film izliyor."
    },
    {
     "en": "We are waiting in line.",
     "tr": "Sırada bekliyoruz."
    },
    {
     "en": "She isn't using her phone.",
     "tr": "Telefonunu kullanmıyor."
    },
    {
     "en": "Are you making a cake?",
     "tr": "Pasta mı yapıyorsun?"
    }
   ],
