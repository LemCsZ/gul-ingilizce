  "listening": {
   "title": "A phone call from the supermarket",
   "script": [
    {
     "speaker": "Hafsa",
     "text": "Hello, Linda? It's Hafsa. Are you busy?"
    },
    {
     "speaker": "Linda",
     "text": "No, I'm just sitting at home. Where are you?"
    },
    {
     "speaker": "Hafsa",
     "text": "I'm at the supermarket. I'm standing in the milk aisle."
    },
    {
     "speaker": "Linda",
     "text": "Oh good. Are you buying eggs?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I am. Do you need anything?"
    },
    {
     "speaker": "Linda",
     "text": "Yes, please. I'm making a cake, and I need sugar."
    },
    {
     "speaker": "Hafsa",
     "text": "Sure. How much sugar are you using?"
    },
    {
     "speaker": "Linda",
     "text": "Two cups. Emre is helping me, by the way."
    },
    {
     "speaker": "Hafsa",
     "text": "Emre is at your house? What is he doing?"
    },
    {
     "speaker": "Linda",
     "text": "He's reading a book in the living room. He isn't making noise!"
    },
    {
     "speaker": "Hafsa",
     "text": "That's great. I'm leaving the store in ten minutes."
    },
    {
     "speaker": "Linda",
     "text": "Perfect. The cake is baking, and it smells wonderful."
    },
    {
     "speaker": "Hafsa",
     "text": "Wonderful. See you soon!"
    }
   ],
