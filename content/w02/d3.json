 "evening": {
  "listening": {
   "title": "Lunch in the teachers' room",
   "script": [
    {
     "speaker": "Ms. Carter",
     "text": "Hi, you are Hafsa, right? I'm Ms. Carter. Nice to meet you."
    },
    {
     "speaker": "Hafsa",
     "text": "Nice to meet you, too. Do you teach here?"
    },
    {
     "speaker": "Ms. Carter",
     "text": "Yes, I do. I teach fourth grade. Do you work in the cafeteria?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, I do. It's my first week."
    },
    {
     "speaker": "Ms. Carter",
     "text": "Does Ms. Davis help you?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, she does. She is very kind."
    },
    {
     "speaker": "Ms. Carter",
     "text": "Do you eat lunch here every day?"
    },
    {
     "speaker": "Hafsa",
     "text": "No, I don't. Today is special. Mr. Brown invites me."
    },
    {
     "speaker": "Ms. Carter",
     "text": "Does your son go to this school?"
    },
    {
     "speaker": "Hafsa",
     "text": "Yes, he does. Emre is in third grade."
    },
    {
     "speaker": "Ms. Carter",
     "text": "Does he like it?"
    },
    {
     "speaker": "Hafsa",
     "text": "He does, but he is shy. Do the students talk to new kids?"
    },
    {
     "speaker": "Ms. Carter",
     "text": "Yes, they do. Your son makes friends fast, I'm sure."
    }
   ],
