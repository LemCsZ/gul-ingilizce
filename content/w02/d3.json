 "morning": {
  "grammar": {
   "topic": "Present Simple soru: Do / Does ve kısa cevaplar",
   "explainTr": [
    "Present Simple'da soru yapmak için cümlenin başına Do veya Does koyarsın. I, you, we, they ile Do gelir: Do you work here? He, she, it ile Does gelir: Does she work here?",
    "Does geldikten sonra fiil yalın kalır, -s yine eklenmez: Does she speak Spanish? (Does she speaks değil.)",
    "Kısa cevap verirken yardımcı fiili tekrar edersin: Yes, I do. / No, I don't. Yes, she does. / No, she doesn't. Wh- sorularında (where, what, when) Do/Does bu kelimelerden sonra gelir: Where does he live?"
   ],
   "compareTr": "Türkçede soru için 'mi' eki yeter (çalışıyor musun?). İngilizcede cümlenin başına Do/Does gelir ve ikinci fiil yalın kalır. 'Evet/hayır' yerine yardımcı fiille cevap verilir.",
   "table": [
    [
     "I / you / we / they",
     "Do + özne + fiil?",
     "Do you work here?"
    ],
    [
     "he / she / it",
     "Does + özne + fiil?",
     "Does she work here?"
    ],
    [
     "Kısa cevap (+)",
     "Yes, ... do/does.",
     "Yes, I do. Yes, he does."
    ],
    [
     "Kısa cevap (-)",
     "No, ... don't/doesn't.",
     "No, I don't. No, he doesn't."
    ]
   ],
   "examples": [
    {
     "en": "Do you live near the school?",
     "tr": "Okulun yakınında mı yaşıyorsun?"
    },
    {
     "en": "Does your son like his teacher?",
     "tr": "Oğlun öğretmenini seviyor mu?"
    },
    {
     "en": "Yes, he does.",
     "tr": "Evet, seviyor."
    },
    {
     "en": "No, I don't.",
     "tr": "Hayır, sevmem."
    },
    {
     "en": "Where does Linda work?",
     "tr": "Linda nerede çalışıyor?"
    }
   ],
